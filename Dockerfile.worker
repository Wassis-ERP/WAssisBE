FROM mcr.microsoft.com/dotnet/sdk:10.0.401@sha256:e70cdb7f80b0348f5cb85f19a8f670fca061f033d57eed12fa003d58b0e06317 AS build
WORKDIR /src

COPY WAssisInsurance.sln ./
COPY src/WAssis.Domain.Core/WAssis.Domain.Core.csproj src/WAssis.Domain.Core/
COPY src/WAssis.Domain/WAssis.Domain.csproj src/WAssis.Domain/
COPY src/WAssis.Application/WAssis.Application.csproj src/WAssis.Application/
COPY src/WAssis.Infra.CrossCutting.Bus/WAssis.Infra.CrossCutting.Bus.csproj src/WAssis.Infra.CrossCutting.Bus/
COPY src/WAssis.Infra.CrossCutting.Identity/WAssis.Infra.CrossCutting.Identity.csproj src/WAssis.Infra.CrossCutting.Identity/
COPY src/WAssis.Infra.CrossCutting.IoC/WAssis.Infra.CrossCutting.IoC.csproj src/WAssis.Infra.CrossCutting.IoC/
COPY src/WAssis.Infra.Data/WAssis.Infra.Data.csproj src/WAssis.Infra.Data/
COPY src/WAssis.Services.Api/WAssis.Services.Api.csproj src/WAssis.Services.Api/
COPY src/WAssis.BackgroundTasks/WAssis.BackgroundTasks.csproj src/WAssis.BackgroundTasks/
COPY src/WAssis.UI.Web/WAssis.UI.Web.csproj src/WAssis.UI.Web/
COPY tests/WAssis.Tests/WAssis.Tests.csproj tests/WAssis.Tests/

COPY global.json ./
COPY Directory.Build.props NuGet.Config ./
COPY src/WAssis.Domain.Core/packages.lock.json src/WAssis.Domain.Core/
COPY src/WAssis.Domain/packages.lock.json src/WAssis.Domain/
COPY src/WAssis.Application/packages.lock.json src/WAssis.Application/
COPY src/WAssis.Infra.CrossCutting.Bus/packages.lock.json src/WAssis.Infra.CrossCutting.Bus/
COPY src/WAssis.Infra.CrossCutting.Identity/packages.lock.json src/WAssis.Infra.CrossCutting.Identity/
COPY src/WAssis.Infra.CrossCutting.IoC/packages.lock.json src/WAssis.Infra.CrossCutting.IoC/
COPY src/WAssis.Infra.Data/packages.lock.json src/WAssis.Infra.Data/
COPY src/WAssis.Services.Api/packages.lock.json src/WAssis.Services.Api/
COPY src/WAssis.BackgroundTasks/packages.lock.json src/WAssis.BackgroundTasks/
COPY src/WAssis.UI.Web/packages.lock.json src/WAssis.UI.Web/
COPY tests/WAssis.Tests/packages.lock.json tests/WAssis.Tests/

RUN dotnet restore WAssisInsurance.sln --locked-mode

COPY . .
RUN dotnet publish src/WAssis.BackgroundTasks/WAssis.BackgroundTasks.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish \
    -p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0.12@sha256:222759b391a1aaf241166672c8f99b2d4ada452e7b5319f3c6e8f265a37b5ad4 AS runtime
WORKDIR /app

ARG BUILD_SHA=local
ENV BUILD_SHA=$BUILD_SHA

COPY --from=build /app/publish .
USER $APP_UID
ENTRYPOINT ["dotnet", "WAssis.BackgroundTasks.dll"]
